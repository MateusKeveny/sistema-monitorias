{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O nome vira o endereço: <nome>.<subdomínio da conta>.workers.dev.
  //
  // Trocar aqui NÃO renomeia o Worker existente: a Cloudflare cria um novo com
  // o nome novo e o antigo continua no ar servindo o endereço velho. Isso dá
  // uma janela de transição, mas o antigo precisa ser apagado depois — senão
  // ficam dois sistemas idênticos apontando para o mesmo banco.
  "name": "painel-monitorias",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat dá ao Worker as APIs de Node que o Next.js usa.
  // nodejs_compat_populate_process_env expõe as variáveis em process.env,
  // que é como o código lê as chaves do Supabase.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Smart Placement (1.39.3): a Cloudflare passa a rodar o Worker perto do
  // banco quando isso encurta as idas ao Supabase — cada tela faz várias.
  // Vale para os três sites (o env herda).
  "placement": { "mode": "smart" },
  // Segundo site, com o mesmo código: o Painel de Performance (cota).
  // `opennextjs-cloudflare deploy --env performance` publica neste Worker.
  // Qual sistema cada site mostra é decidido pelo endereço (lib/sistema.ts),
  // então o nome abaixo precisa começar com "painel-performance".
  "env": {
    "performance": {
      "name": "painel-performance",
      "observability": {
        "enabled": true
      },
      // Aviso no computador (2.4.0): a mesma chave VAPID da Agenda; a privada é
      // segredo do Worker: `node scripts/chaves-da-agenda.js performance`.
      "vars": {
        "VAPID_PUBLICA": "BCQCqXSYb9IlViA4t1M6eso9tLXIWz__I3VN6JMITHsq_sEuG6zVm14UyLgLn_UJux1V42ianEW4fOpF4P6lxyA"
      }
    },
    // Cópia de teste do Performance (2.10.0): o mesmo código e o MESMO banco,
    // para o gestor acompanhar uma mudança antes do site oficial. O nome não
    // termina em "painel-performance.", então o sistema vem de SISTEMA=cota.
    // COPIA_DE_TESTE liga o "Ver como atendente" — só aqui.
    // Publicar: npm run cf:deploy:teste
    "teste": {
      "name": "painel-performance-teste",
      "observability": {
        "enabled": true
      },
      "vars": {
        "SISTEMA": "cota",
        "COPIA_DE_TESTE": "1"
      }
    },
    // Terceiro site: a Agenda da Gestão (migração 59), também pelo endereço —
    // o nome precisa começar com "painel-agenda". A chave pública VAPID é
    // pública de verdade (vai para o navegador); a privada e o segredo do
    // envio são segredos do Worker: `node scripts/chaves-da-agenda.js worker`.
    "agenda": {
      "name": "painel-agenda",
      "observability": {
        "enabled": true
      },
      "vars": {
        "VAPID_PUBLICA": "BCQCqXSYb9IlViA4t1M6eso9tLXIWz__I3VN6JMITHsq_sEuG6zVm14UyLgLn_UJux1V42ianEW4fOpF4P6lxyA"
      }
    }
  }
}
